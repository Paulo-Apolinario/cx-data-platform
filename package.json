{
  "name": "gestao-obras",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gestão de obras para um engenheiro e portal privado de clientes",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "setup": "node --env-file-if-exists=.env scripts/setup.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "dev": "node --env-file-if-exists=.env --watch server/index.mjs",
    "test": "node --test tests/*.test.mjs"
  }
}
